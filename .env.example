# Environment Configuration for AI Reel Recommender
# The system runs 100% locally and offline by default.
# Optional LLM API Key for advanced semantic expansions (Leave blank for deterministic fallback)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Recommendation Algorithm Hyperparameters
EXPLORATION_WEIGHT=0.20
REPETITION_PENALTY=0.25
HYPE_PENALTY_WEIGHT=0.35
